# UO2I2(OH2)2 - DFT Single Point with LANL2DZ ECP
# Most reliable ECP for heavy elements in NWChem

title "UO2I2(OH2)2 - DFT Single Point"

# Memory allocation
memory heap 1024 mb stack 512 mb global 2048 mb

# Geometry from uo2i2_initial.xyz
geometry units angstroms noautoz
  U       0.000000      0.000000      0.000000
  O       0.000000      0.000000      1.773000
  O       0.000000      0.000000     -1.773000
  I       0.000000     -3.026700      0.000000
  I       0.000000      3.026700      0.000000
  O       2.318000      0.000000      0.000000
  O      -2.318000      0.000000      0.000000
  H       2.657900     -0.748700      0.050000
  H       2.657900      0.748700     -0.050000
  H      -2.657900     -0.748700     -0.050000
  H      -2.657900      0.748700      0.050000
end

# Basis sets with LANL2DZ ECP
basis
  # Uranium: LANL2DZ ECP
  #U library "lanl2dz_ecp"
  U library "crenbl_ecp"
  # Iodine: LANL2DZ ECP
  #I library "lanl2dz_ecp"
  I library "crenbl_ecp"
  # Oxygen: 6-31G*
  O library  "6-31G*"
  # Hydrogen: 6-31G*
  H library "6-31G*"
end

# DFT settings
dft
  xc b3lyp
end

# Single point energy calculation
task dft energy
