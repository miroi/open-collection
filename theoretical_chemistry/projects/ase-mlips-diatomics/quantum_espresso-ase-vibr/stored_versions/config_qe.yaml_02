# Vibration settings
vibration_method: 'xonly'  # Options: '1d', 'xonly', 'full', or 'both'

# 1D Scan settings (fast, quadratic fit)
1d_settings:
  delta: 0.005
  n_points: 7

# X-Only Full Hessian (accurate, only along bond)
xonly_settings:
  delta: 0.005
  nfree: 2                  # Only 2 displacements for x-direction

# Full 3D Hessian (most accurate but slow)
full_settings:
  delta: 0.005
  nfree: 2                  # 2 displacements for all 3 directions
