   starting_magnetization(2) = 0.8000
   starting_magnetization(3) = 0.0000
/
&ELECTRONS
   conv_thr          = 1.0d-8
   electron_maxstep  = 300
   diagonalization   = 'david'
/
&MIXING
   mixing_beta       = 0.2
   mixing_mode       = 'plain'
   mixing_type       = 'plain'
/
&IONS
   ion_dynamics      = 'bfgs'
/
