&CONTROL
   calculation       = 'scf'
   prefix            = 'GdMnO3'
   outdir            = './tmp'
   pseudo_dir        = './'
   restart_mode      = 'from_scratch'
   tstress           = .true.
   tprnfor           = .true.
   disk_io           = 'low'
   verbosity         = 'high'
/
&SYSTEM
   ibrav             = 0
   nat               = 20
   ntyp              = 3
   ecutwfc           = 60.0
   ecutrho           = 480.0
   occupations       = 'smearing'
   smearing          = 'gaussian'
   degauss           = 0.01
   nspin             = 2
