#!/bin/bash

#SBATCH -J DALdft

##  partition (queue)
#SBATCH --account=bltp
#SBATCH --partition=bltp
#SBATCH --constraint=icelake
#SBATCH --qos=medium

## max. execution time
#SBATCH -t 0-05:00:00

##SBATCH --exclusive

##SBATCH --mem=264GB
#SBATCH --mem=34GB

# do not restart in the case of nodefail!
#SBATCH --no-requeue
#SBATCH --no-kill

#SBATCH -N 1 -n 4

##SBATCH  --sockets-per-node=1

## memory NO !!!
##SBATCH --mem-per-cpu=28G

## stdout/stderr output file
##SBATCH -o log_slurm_job.%j.%N.std_out_err
#SBATCH -o log_slurm_job.%j.%N.std_out

## mail
#SBATCH --mail-user=milias@jinr.ru
#SBATCH --mail-type=ALL

echo -e "\nRunning on host `hostname`"
echo -e "Time is `date` \n"
ulimit -s unlimited

echo -e "The total memory at the node (in GB)"
free -t -g
 
echo -e "\n\n Job user is SLURM_JOB_USER=$SLURM_JOB_USER and his job SLURM_JOB_NAME=$SLURM_JOB_NAME has assigned ID SLURM_JOBID=$SLURM_JOBID"
echo -e "This job was submitted from the computer SLURM_SUBMIT_HOST=$SLURM_SUBMIT_HOST"
echo -e " and from the home directory:"
echo -e "SLURM_SUBMIT_DIR=$SLURM_SUBMIT_DIR"
echo -e "It is running on the cluster compute node:"
echo -e "SLURM_CLUSTER_NAME=$SLURM_CLUSTER_NAME"
echo -e "and is employing SLURM_JOB_NUM_NODES= $SLURM_JOB_NUM_NODES node/nodes:"
echo -e "SLURM_JOB_NODELIST=$SLURM_JOB_NODELIST"
echo -e "Job partition is SLURM_JOB_PARTITION=$SLURM_JOB_PARTITION "
echo -e "Job constraint is SLURM_JOB_CONSTRAINTS=$SLURM_JOB_CONSTRAINTS"
echo -e The job requests SLURM_CPUS_ON_NODE=$SLURM_CPUS_ON_NODE CPU per task.

# CPU model, total numer of CPUs, number of allocated CPUs
echo -e "\n\n The node's CPU \c"; cat /proc/cpuinfo | grep 'model name' | uniq
NPROCS=`cat /proc/cpuinfo | grep processor | wc -l`
echo "This node has total NPROCS=$NPROCS CPUs available for an EXCLUSIVE job."
echo "Based on reserved memory, this node got SLURM_CPUS_ON_NODE=$SLURM_CPUS_ON_NODE CPUs allocated for SLURM calculations."
echo "This job wants SLURM_NTASKS=$SLURM_NTASKS threads . "


#MACHINEFILE="nodes.$SLURM_JOB_PARTITION.$SLURM_JOB_ID"
# Generate Machinefile for mpi such that hosts are in the same
# order as if run via srun
#srun -l /bin/hostname | sort -n | awk '{print $2}' > $MACHINEFILE
echo -e "\n Allocated working nodes:"
srun -l /bin/hostname | sort -n | awk '{print $2}' 
#echo -e "\ngenerated machinefile for MPI, $MACHINEFILE"; ls -lt $PWD/$MACHINEFILE; echo "containing:"; cat $MACHINEFILE

# J.Busa Jr. module path
#export MODULEPATH=/cvmfs/nica.jinr.ru/sw/202309/MODULES/slc9_x86-64:$MODULEPATH 
#echo -e  "\n\n For modules, extended MODULEPATH=$MODULEPATH:"

echo -e "\n\n Loading modules ...."
module purge
#module add Python/v3.12.13  
#module add CMake/v4.2.3
module add Python/v3.12.13
module add intel/v2026.1.0

#module add openmpi/v5.0.3_gcc1230
#module add LAPACK/v3.12.0_gcc1230
#module add Python/v3.12.4-1 # Of J.Busa Jr.
echo -e "List of loaded modules:"
module list

echo -e "\n\n Checking the software for code buildup :"
echo -e "  python ? :\c"; which python; python -V
#echo -e "  cmake ? :\c";  which cmake; cmake --version
echo -e "  mpiifx ? :\c"; which mpiifx; mpiifx -V
echo -e "  mpiicx ? :\c"; which mpiicx; mpiicx -V
echo -e "  mpiicpx ? :\c"; which mpiicpx; mpiicpx  -V
echo -e "  mpiexec ? :\c"; which mpiexec; mpiexec --version
echo -e "\n Intel MKL library ? MKLROOT=$MKLROOT"; ls -lt  $MKLROOT/lib/intel64

echo -e "\n\n The variable PATH=$PATH"
echo -e "\n The variable LD_LIBRARY_PATH=$LD_LIBRARY_PATH "

DALTON=/lustre/projects/m/milias/work/software/dalton/dalton_cloned
BUILD=build_intelmpi2026_mkl_i8
DAL_LAUNCH=$DALTON/$BUILD/dalton
echo -e "\n\n DALTON build directory, BUILD=$BUILD"
if [ -d $DALTON/$BUILD ]; then
  echo -e "\n Directory DALTON/BUILD=$DALTON/$BUILD"
  echo -e "\n DALTON executable :"
  ls -lt  $DALTON/$BUILD/dalton.x
  ldd $DALTON/$BUILD/dalton.x
  echo -e "\n DALTON launching script :"
  ls -lt $DAL_LAUNCH
  $DAL_LAUNCH --help
fi

export DALTON_TMPDIR=/lustre/projects/m/milias/DIRAC_scratch
echo -e "\n\n scratch directory, DALTON_TMPDIR=$DALTON_TMPDIR"
export DALTON_LAUNCHER="mpiexec -ilp64 -np $SLURM_NTASKS"
echo -e "DALTON_LAUNCHER=$DALTON_LAUNCHER"

# test /lustre/projects/m/milias/work/software/dalton/dalton_cloned/DALTON/test/dft_properties_sym
dalf=dft_properties_sym.dal
molf=H2O_cc-pVDZ.mol

echo -e "\n\n Launching Dalton with dalfile=$dalf & molfile=$molf :"
$DAL_LAUNCH -w $SLURM_SUBMIT_DIR -noarch -gb 7 -dal $dalf -mol $molf

exit
