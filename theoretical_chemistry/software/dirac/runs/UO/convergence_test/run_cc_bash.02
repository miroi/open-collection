#!/bin/bash

echo -e "running DIRAC job"

# initialize Intel compilers
.  /opt/intel/oneapi/setvars.sh


DIRAC=/home/miroi/work/software/dirac/trunk_cloned
BUILD=build_intelmpi_mkl_ilp64
PAM=$DIRAC/$BUILD/pam
# check pam
ls -lt $PAM

molf=UO_Cinfv.mol
#inpf=UO.ecp_scf_resolve.inp
inpf=UO.ecp_scf_res_cc.inp

#$PAM --noarch --mpi=6 --mol=$molf --inp=$inpf --get="DFPCMO=DFPCMO_UO_ecp"

$PAM --noarch --mpi=6 --mol=$molf --inp=$inpf --put="DFPCMO_UO_ecp=DFPCMO"


exit 0
