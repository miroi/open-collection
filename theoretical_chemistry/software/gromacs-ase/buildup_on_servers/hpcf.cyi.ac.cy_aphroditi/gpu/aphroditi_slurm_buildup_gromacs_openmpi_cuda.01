#!/bin/bash -l

#SBATCH -A p326

#SBATCH --job-name=GMX
##SBATCH --partition=milan 
#SBATCH --partition=rtx
#SBATCH --nodes=1 
#SBATCH --ntasks-per-node=4 
#SBATCH --time=4:00:00 

## stdout/stderr output file
#SBATCH -o log_slurm_job.%j.%N.std_out

## email
##SBATCH --mail-user=milias@theor.jinr.ru
##SBATCH --mail-type=ALL


echo -e "\n Job user is $SLURM_JOB_USER and his job $SLURM_JOB_NAME has assigned ID $SLURM_JOBID"
echo This job was submitted from the computer $SLURM_SUBMIT_HOST
echo and from the home directory:
echo $SLURM_SUBMIT_DIR
echo
echo It is running on the cluster compute node:
echo $SLURM_CLUSTER_NAME
echo and is employing $SLURM_JOB_NUM_NODES node/nodes:
echo $SLURM_JOB_NODELIST
echo
echo -e "Job partition is $SLURM_JOB_PARTITION \n"
echo The job requests $SLURM_CPUS_ON_NODE CPU per task.

module purge
module load  Python CMake
#module load  intel
module load GCC OpenMPI CUDA imkl

echo -e "\n\n...loaded modules :"
module list

# Check GPU availability and compute capability
echo -e "\n\nChecking GPU hardware:"
if command -v nvidia-smi &> /dev/null; then
    echo "✅ nvidia-smi found: $(which nvidia-smi)"
    nvidia-smi --query-gpu=name,compute_cap,memory.total --format=csv
else
    echo "⚠️  nvidia-smi not found (might be on compute node without GPU access)"
    echo "Will check compute capability later with CMake"
fi
# Check CUDA samples/test
echo -e "\nTesting CUDA compilation:"
cat > test_cuda.cu << EOF
#include <cuda_runtime.h>
#include <stdio.h>
int main() {
    int deviceCount;
    cudaGetDeviceCount(&deviceCount);
    printf("Found %d CUDA devices\n", deviceCount);
    for (int i=0; i<deviceCount; i++) {
        cudaDeviceProp prop;
        cudaGetDeviceProperties(&prop, i);
        printf("Device %d: %s (CC: %d.%d)\n", i, prop.name, prop.major, prop.minor);
    }
    return 0;
}
EOF

if nvcc -o test_cuda test_cuda.cu 2>/dev/null; then
    echo "✅ CUDA compilation successful"
    if ./test_cuda 2>/dev/null; then
        echo "✅ CUDA runtime test successful"
    else
        echo "⚠️  CUDA runtime test failed (no GPU access?)"
    fi
    rm -f test_cuda test_cuda.cu
else
    echo "⚠️  CUDA compilation test failed (this is OK if compiling for different GPU)"
    rm -f test_cuda.cu
fi

    # Check MPI compilers
    if command -v mpicc &> /dev/null; then
        echo -e "\n✅ mpicc found: $(which mpicc)"
        echo "mpicc version:"
        mpicc --version 2>&1 | head -3
    else
        echo -e "\n❌ mpicc NOT found in PATH"
        echo "Searching for MPI installations..."
        find /eb/software -name "mpicc" -type f 2>/dev/null | head -5
    fi
    
    if command -v mpirun &> /dev/null; then
        echo -e "\n✅ mpirun found: $(which mpirun)"
        echo "mpirun version:"
        mpirun --version 2>&1 | head -3
    else
        echo -e "\n❌ mpirun NOT found"
    fi

# 
  echo -e "\n\n*** hydra.jinr.ru setting for compilation:   ***"

  export GROMACS_ROOT=/nvme/h/ru26mi1/work/software/gromacs
  export GROMACS=$GROMACS_ROOT/gromacs_cloned
  export REGTESTS=$GROMACS_ROOT/gromacs-regressiontests
  #export BUILD=build_intelmpi2025.3.1_mkl
  export BUILD=build-gpu_openmpi_cuda

  INSTALL_DIR=$GROMACS_ROOT/install_$BUILD
  echo "\n INSTALL_DIR=$INSTALL_DIR"
  if [ -d "install_$BUILD" ]; then
    echo -e "\nPREVIOUS directory 'install_$BUILD' exists. Removing it.After recreating it again by mkdir."
    rm -rf install_$BUILD
  else
    echo -e "\nPREVIOUS directory 'install_$BUILD' does not exist - will be created by mkdir."
  fi
  mkdir install_$BUILD

  echo -e "\n GROMACS=$GROMACS"
  echo -e "\n GROMACS REGRESSION TESTS=$REGTESTS"

  #echo -e "ifort ?"; which ifort; ifort --version
 # echo -e "clang ?"; which clang; clang --version
 # echo -e "clang++ ?"; which clang++ ; clang++ --version
  echo -e "\n\nCMake ?"; which cmake; cmake --version
  echo -e "Python ?"; which python; python -V

  echo -e "gcc ?"; which gcc; gcc --version
  #echo -e "icc ?"; which icc; icc --version
  #echo -e "icx ?"; which icx; icx --version
  #echo -e "mpiicpc ?"; which mpiicpc; mpiicpc  --version
 # echo -e "mpiicpx ?"; which mpiicpc; mpiicpc  --version
 # echo -e "mpiifort ?"; which mpiifort; mpiifort -V
  #echo -e "mpiexec ?";  which mpiexec; mpiexec --version
  echo -e "\n ===  We have the MKL library, MKLROOT=${MKLROOT}"

  cd $GROMACS

  if [ -d "$BUILD" ]; then
    echo  -e "\nBuild directory '$BUILD' found, removing it..."
    rm -rf "$BUILD"
  else
    echo -e "\n Previous directory '$BUILD' not found..."
  fi
  mkdir $BUILD
  echo -e "\nEmpty directory '$BUILD' created..."

  cd $BUILD
  echo -e "\n I am in GROMACS/BUILD=$GROMACS/$BUILD:\c";
  echo -e "\n                   pwd=\c";pwd

# The Intel classic compiler (icc/icpc) is no longer supported in GROMACS. Use Intel’s newer clang-based compiler from oneAPI, or gcc.
  echo -e "\n\n running cmake configuration : "
 # cmake .. -DCMAKE_C_COMPILER=clang -DCMAKE_CXX_COMPILER=clang++  -DGMX_MPI=on  -DGMX_FFT_LIBRARY=mkl  -DGMX_OPENMP=OFF -DREGRESSIONTEST_DOWNLOAD=OFF -DREGRESSIONTEST_PATH=$REGTESTS
#  cmake .. -DCMAKE_C_COMPILER=icx -DCMAKE_CXX_COMPILER=mpiicpx  -DGMX_MPI=on  -DGMX_FFT_LIBRARY=mkl  -DGMX_OPENMP=OFF -DREGRESSIONTEST_DOWNLOAD=OFF -DREGRESSIONTEST_PATH=$REGTESTS
#  cmake .. -DCMAKE_C_COMPILER=icc -DCMAKE_CXX_COMPILER=mpiicpc -DGMX_MPI=on  -DGMX_FFT_LIBRARY=mkl  -DGMX_OPENMP=OFF -DREGRESSIONTEST_DOWNLOAD=OFF -DREGRESSIONTEST_PATH=$REGTESTS
#  cmake .. -DCMAKE_C_COMPILER=gcc -DCMAKE_CXX_COMPILER=g++  -DGMX_MPI=on  -DGMX_FFT_LIBRARY=mkl  -DGMX_OPENMP=ON  -DGMX_GPU=OFF  -DREGRESSIONTEST_DOWNLOAD=OFF -DREGRESSIONTEST_PATH=$REGTESTS

  cmake .. -DCMAKE_INSTALL_PREFIX=$INSTALL_DIR -DCMAKE_C_COMPILER=gcc -DCMAKE_CXX_COMPILER=g++  -DGMX_MPI=ON  -DGMX_FFT_LIBRARY=mkl  -DGMX_THREAD_MPI=ON  -DGMX_OPENMP=ON  -DGMX_GPU=CUDA  -DGMX_DOUBLE=OFF -DREGRESSIONTEST_DOWNLOAD=OFF -DREGRESSIONTEST_PATH=$REGTESTS
  

  echo -e "\n\n running make -j $SLURM_CPUS_ON_NODE : "
  #make -j $SLURM_CPUS_ON_NODE
  make VERBOSE=2 -j $SLURM_CPUS_ON_NODE

  make install
  echo -e "\n\n After make install; ls $INSTALL_DIR "; ls $INSTALL_DIR
   
  echo -e "\n\n After, ls -lt bin :"
  ls -lt bin
  echo -e " ldd bin/gmx_mpi :"
  ldd bin/gmx_mpi

  echo -e "\n\n make check :"
  make VERBOSE=2 check
  #make check

  exit 0
