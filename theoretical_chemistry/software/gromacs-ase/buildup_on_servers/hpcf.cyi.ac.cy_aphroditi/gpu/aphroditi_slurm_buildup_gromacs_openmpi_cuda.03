#!/bin/bash -l
#SBATCH -A p326
#SBATCH --job-name=GMX_build
#SBATCH --partition=rtx
#SBATCH --nodes=1
#SBATCH --ntasks=4             # slots for 2/4-rank MPI tests
#SBATCH --cpus-per-task=2          # 4 x 2 = 8 cores in total
#SBATCH --gres=gpu:1            # GPU must be visible for detection and tests
#SBATCH --time=2:00:00
#SBATCH -o log_slurm_job.%j.%N.std_out

#SBATCH --mail-user=milias@theor.jinr.ru
#SBATCH --mail-type=ALL

# Usage: sbatch THISSCRIPT            (MPI build, quick tests)
#        TEST_MODE=none|quick|full   none = skip building/running tests (lightest)
#        RUN_REGRESSION=true         add the 8-rank regression tests (needs --ntasks=8)
#        USE_MPI=false sbatch --export=ALL ...   (thread-MPI build, best for 1 node)
USE_MPI=${USE_MPI:-true}
TEST_MODE=${TEST_MODE:-quick}
RUN_REGRESSION=${RUN_REGRESSION:-false}
NCPU=$(( ${SLURM_NTASKS:-1} * ${SLURM_CPUS_PER_TASK:-4} ))

module purge
module load Python CMake
module load GCC OpenMPI CUDA imkl

echo -e "\n\n...loaded modules :"
module list

set -eo pipefail   # stop on first error (after module commands)

echo -e  "\n\n == GPU =="
nvidia-smi --query-gpu=name,compute_cap,memory.total --format=csv
CC=$(nvidia-smi --query-gpu=compute_cap --format=csv,noheader | head -1 | tr -d '.')
echo -e "\n CUDA target SM: ${CC:-unknown}"
CUDA_ARCH_OPT=""
[ -n "$CC" ] && CUDA_ARCH_OPT="-DCMAKE_CUDA_ARCHITECTURES=$CC"

echo -e "\n == CPU SIMD flags =="
lscpu | grep -o -w -E 'avx512f|avx2' | sort -u

if [ "$USE_MPI" = true ]; then
    command -v mpicc >/dev/null || { echo "mpicc not found"; exit 1; }
    echo "CUDA-aware OpenMPI? (want ...:true)"
    ompi_info --parsable --all | grep mpi_built_with_cuda_support:value || true
    GMX_MPI=ON;  GMX_THREAD_MPI=OFF; CCOMP=mpicc; CXXCOMP=mpicxx; FLAVOR=mpi
else
    GMX_MPI=OFF; GMX_THREAD_MPI=ON;  CCOMP=gcc;   CXXCOMP=g++;    FLAVOR=tmpi
fi

export GROMACS_ROOT=/nvme/h/ru26mi1/work/software/gromacs
export GROMACS=$GROMACS_ROOT/gromacs_cloned
export REGTESTS=$GROMACS_ROOT/gromacs-regressiontests
BUILD=build-gpu_cuda_$FLAVOR
echo -e "\n CMake  BUILD=$BUILD"
INSTALL_DIR=$GROMACS_ROOT/install_$BUILD
echo -e "\n CMake  INSTALL_DIR=$INSTALL_DIR"

echo -e "\n GROMACS commit: $(git -C "$GROMACS" describe --always --dirty)"
echo -e "\n MKLROOT=${MKLROOT:?MKLROOT not set - imkl module missing}"

UNITTESTS=ON; [ "$TEST_MODE" = none ] && UNITTESTS=OFF   # OFF skips compiling ~100 test binaries
REGR_OPT="-DREGRESSIONTEST_DOWNLOAD=OFF"
[ "$RUN_REGRESSION" = true ] && REGR_OPT="$REGR_OPT -DREGRESSIONTEST_PATH=$REGTESTS"

rm -rf "${INSTALL_DIR:?}"; mkdir -p "$INSTALL_DIR"
cd "$GROMACS"
rm -rf "${BUILD:?}"; mkdir "$BUILD"; cd "$BUILD"

cmake .. \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_INSTALL_PREFIX="$INSTALL_DIR" \
  -DCMAKE_C_COMPILER=$CCOMP \
  -DCMAKE_CXX_COMPILER=$CXXCOMP \
  -DGMX_MPI=$GMX_MPI \
  -DGMX_THREAD_MPI=$GMX_THREAD_MPI \
  -DGMX_OPENMP=ON -DGMX_HWLOC=ON -DCMAKE_PREFIX_PATH="${EBROOTHWLOC:-}" \
  -DGMX_GPU=CUDA $CUDA_ARCH_OPT \
  -DGMX_DOUBLE=OFF \
  -DGMX_FFT_LIBRARY=mkl \
  -DGMX_BUILD_OWN_FFTW=OFF \
  -DGMX_BUILD_UNITTESTS=$UNITTESTS $REGR_OPT
# Cross-partition builds: add -DGMX_SIMD=AVX2_256 (or AVX_512) explicitly.

make -j "$NCPU"

# Tests: keep a good build even if some tests fail; verdict goes to exit code.
CHECK_RC=0
case "$TEST_MODE" in
  none)  echo "Tests skipped (TEST_MODE=none)";;
  quick) make -j "$NCPU" tests
         ctest -j 2 -L "UnitTest|QuickGpuTest" --output-on-failure || CHECK_RC=1;;
  full)  make -j "$NCPU" check || CHECK_RC=1;;
esac

make install
ls -lt "$INSTALL_DIR/bin"
BIN=$INSTALL_DIR/bin/gmx; [ "$USE_MPI" = true ] && BIN=$INSTALL_DIR/bin/gmx_mpi
ldd "$BIN"
source "$INSTALL_DIR/bin/GMXRC"
"$BIN" --version | head -40

echo "make check exit status: $CHECK_RC"
exit $CHECK_RC
