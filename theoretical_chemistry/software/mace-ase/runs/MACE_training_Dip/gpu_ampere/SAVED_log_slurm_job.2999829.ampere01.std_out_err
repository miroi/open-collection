                        Key of polarizability in training xyz (default:
                        polarizability)
  --magmom_key MAGMOM_KEY
                        Key of magnetic moment in training xyz (default:
                        REF_magmom)
  --magforces_key MAGFORCES_KEY
                        Key of magnetic forces in training xyz (default:
                        REF_magforces)
  --head_key HEAD_KEY   Key of head in training xyz (default: head)
  --charges_key CHARGES_KEY
                        Key of atomic charges in training xyz (default:
                        REF_charges)
  --elec_temp_key ELEC_TEMP_KEY
                        Key of electronic temperature in training xyz
                        (default: elec_temp)
  --total_spin_key TOTAL_SPIN_KEY
                        Key of total spin in training xyz (default:
                        total_spin)
  --total_charge_key TOTAL_CHARGE_KEY
                        Key of total charge in training xyz (default:
                        total_charge)
  --embedding_specs EMBEDDING_SPECS
                        Dict of feature‐spec dictionaries. embedding_specs:
                        total_spin: type: categorical per: graph num_classes:
                        101 emb_dim: 64 total_charge: type: categorical per:
                        graph num_classes: 201 emb_dim: 64 temperature: type:
                        continuous per: graph in_dim: 1 emb_dim: 32 (default:
                        None)
  --skip_evaluate_heads SKIP_EVALUATE_HEADS
                        Comma-separated list of heads to skip during final
                        evaluation (default: pt_head)
  --loss {ef,weighted,forces_only,virials,stress,dipole,dipole_polar,huber,universal,energy_forces_dipole,l1l2energyforces}
                        type of loss (default: weighted)
  --forces_weight FORCES_WEIGHT
                        weight of forces loss (default: 100.0)
  --swa_forces_weight SWA_FORCES_WEIGHT, --stage_two_forces_weight SWA_FORCES_WEIGHT
                        weight of forces loss after starting Stage Two
                        (previously called swa) (default: 100.0)
  --magforces_weight MAGFORCES_WEIGHT
                        weight of mag forces loss (default: 100.0)
  --swa_magforces_weight SWA_MAGFORCES_WEIGHT, --stage_two_magforces_weight SWA_MAGFORCES_WEIGHT
                        weight of magforces loss after starting Stage Two
                        (previously called swa) (default: 100.0)
  --energy_weight ENERGY_WEIGHT
                        weight of energy loss (default: 1.0)
  --swa_energy_weight SWA_ENERGY_WEIGHT, --stage_two_energy_weight SWA_ENERGY_WEIGHT
                        weight of energy loss after starting Stage Two
                        (previously called swa) (default: 1000.0)
  --virials_weight VIRIALS_WEIGHT
                        weight of virials loss (default: 1.0)
  --swa_virials_weight SWA_VIRIALS_WEIGHT, --stage_two_virials_weight SWA_VIRIALS_WEIGHT
                        weight of virials loss after starting Stage Two
                        (previously called swa) (default: 10.0)
  --stress_weight STRESS_WEIGHT
                        weight of stress loss (default: 1.0)
  --swa_stress_weight SWA_STRESS_WEIGHT, --stage_two_stress_weight SWA_STRESS_WEIGHT
                        weight of stress loss after starting Stage Two
                        (previously called swa) (default: 10.0)
  --dipole_weight DIPOLE_WEIGHT
                        weight of dipoles loss (default: 1.0)
  --swa_dipole_weight SWA_DIPOLE_WEIGHT, --stage_two_dipole_weight SWA_DIPOLE_WEIGHT
                        weight of dipoles after starting Stage Two (previously
                        called swa) (default: 1.0)
  --swa_polarizability_weight SWA_POLARIZABILITY_WEIGHT, --stage_two_polarizability_weight SWA_POLARIZABILITY_WEIGHT
                        weight of polarizability after starting Stage Two
                        (previously called swa) (default: 1.0)
  --polarizability_weight POLARIZABILITY_WEIGHT
                        weight of polarizability loss (default: 1.0)
  --config_type_weights CONFIG_TYPE_WEIGHTS
                        String of dictionary containing the weights for each
                        config type (default: {"Default":1.0})
  --huber_delta HUBER_DELTA
                        delta parameter for huber loss (default: 0.01)
  --optimizer {adam,adamw,schedulefree}
                        Optimizer for parameter optimization (default: adam)
  --beta BETA           Beta parameter for the optimizer (default: 0.9)
  --beta1_schedulefree BETA1_SCHEDULEFREE
                        Beta1 parameter for the ScheduleFree optimizer
                        (default: 0.9)
  --beta2_schedulefree BETA2_SCHEDULEFREE
                        Beta2 parameter for the ScheduleFree optimizer
                        (default: 0.98)
  --warmup_steps_schedulefree WARMUP_STEPS_SCHEDULEFREE
                        Number of linear LR warmup steps for the ScheduleFree
                        optimizer (default: 0)
  --batch_size BATCH_SIZE
                        batch size (default: 10)
  --valid_batch_size VALID_BATCH_SIZE
                        Validation batch size (default: 10)
  --lr LR               Learning rate of optimizer (default: 0.01)
  --swa_lr SWA_LR, --stage_two_lr SWA_LR
                        Learning rate of optimizer in Stage Two (previously
                        called swa) (default: 0.001)
  --weight_decay WEIGHT_DECAY
                        weight decay (L2 penalty) (default: 5e-07)
  --lr_params_factors LR_PARAMS_FACTORS
                        Learning rate factors to multiply on the original lr
                        (default: {"embedding_lr_factor": 1.0,
                        "interactions_lr_factor": 1.0, "products_lr_factor":
                        1.0, "readouts_lr_factor": 1.0})
  --freeze FREEZE       Freeze layers from 1 to N. Can be positive or
                        negative, e.g. -1 means the last layer is frozen. 0 or
                        None means all layers are active and is a default
                        setting (default: None)
  --amsgrad             use amsgrad variant of optimizer (default: True)
  --scheduler SCHEDULER
                        Type of scheduler (default: ReduceLROnPlateau)
  --lr_factor LR_FACTOR
                        Learning rate factor (default: 0.8)
  --scheduler_patience SCHEDULER_PATIENCE
                        Learning rate factor (default: 50)
  --lr_scheduler_gamma LR_SCHEDULER_GAMMA
                        Gamma of learning rate scheduler (default: 0.9993)
  --swa, --stage_two    use Stage Two loss weight, which decreases the
                        learning rate and increases the energy weight at the
                        end of the training to help converge them (default:
                        False)
  --start_swa START_SWA, --start_stage_two START_SWA
                        Number of epochs before changing to Stage Two loss
                        weights (default: None)
  --lbfgs               Switch to L-BFGS optimizer (default: False)
  --ema                 use Exponential Moving Average (default: False)
  --ema_decay EMA_DECAY
                        Exponential Moving Average decay (default: 0.99)
  --max_num_epochs MAX_NUM_EPOCHS
                        Maximum number of epochs (default: 2048)
  --patience PATIENCE   Maximum number of consecutive epochs of increasing
                        loss (default: 2048)
  --foundation_model FOUNDATION_MODEL
                        Path to the foundation model for transfer learning
                        (default: None)
  --foundation_model_kwargs FOUNDATION_MODEL_KWARGS
                        Additional kwargs for the foundation model for
                        transfer learning (default: {})
  --foundation_model_readout [FOUNDATION_MODEL_READOUT]
                        Transfer the foundation model's readout weights. Pass
                        the flag with no value to turn the transfer off, or an
                        explicit boolean. (default: True)
  --foundation_filter_elements FOUNDATION_MODEL_READOUT
                        Deprecated alias of --foundation_model_readout.
                        Despite the name it never filtered elements; it
                        decides whether the foundation model's readout weights
                        are transferred. (default: True)
  --finetune_dipoles_polarizabilities FINETUNE_DIPOLES_POLARIZABILITIES
                        Fine-tune an existing AtomicDielectricMACE (MACE-MDP)
                        model on dipoles and polarizabilities only. Requires
                        --foundation_model pointing to the pretrained MDP
                        checkpoint. (default: False)
  --eval_interval EVAL_INTERVAL
                        evaluate model every <n> epochs (default: 1)
  --keep_checkpoints    keep all checkpoints (default: False)
  --save_all_checkpoints
                        save all checkpoints (default: False)
  --restart_latest      restart optimizer from latest checkpoint (default:
                        False)
  --save_cpu            Save a model to be loaded on cpu (default: False)
  --clip_grad CLIP_GRAD
                        Gradient Clipping Value (default: 10.0)
  --dry_run             Run all steps upto training to test settings.
                        (default: False)
  --enable_cueq ENABLE_CUEQ
                        Enable cuequivariance acceleration (default: False)
  --only_cueq ONLY_CUEQ
                        Only use cuequivariance acceleration (default: False)
  --cueq_conv_fusion CUEQ_CONV_FUSION
                        Enable cuEquivariance convolution fusion during
                        training (default: False)
  --enable_oeq ENABLE_OEQ
                        Enable openequivariance acceleration (default: False)
  --wandb               Use Weights and Biases for experiment tracking
                        (default: False)
  --wandb_dir WANDB_DIR
                        An absolute path to a directory where Weights and
                        Biases metadata will be stored (default: None)
  --wandb_project WANDB_PROJECT
                        Weights and Biases project name (default: )
  --wandb_entity WANDB_ENTITY
                        Weights and Biases entity name (default: )
  --wandb_name WANDB_NAME
                        Weights and Biases experiment name (default: )
  --wandb_log_hypers WANDB_LOG_HYPERS [WANDB_LOG_HYPERS ...]
                        The hyperparameters to log in Weights and Biases
                        (default: ['num_channels', 'max_L', 'correlation',
                        'lr', 'swa_lr', 'weight_decay', 'batch_size',
                        'max_num_epochs', 'start_swa', 'energy_weight',
                        'forces_weight'])
  --num_mag_radial_basis_one_body NUM_MAG_RADIAL_BASIS_ONE_BODY
                        number of radial basis for one body contribution in
                        magnetic mace (default: 10)
  --m_max M_MAX [M_MAX ...]
                        |m| saturation per element. Either a dict literal
                        mapping atomic number to m_max (e.g. "{26: 1.8, 28:
                        1.2}" — only listed elements are required, others
                        default to 1.0), or a space-separated list of floats
                        ordered by z_table.zs (legacy). (default: None)
  --max_m_ell MAX_M_ELL
                        max_ell for magnetic mace (default: 3)
  --num_mag_radial_basis NUM_MAG_RADIAL_BASIS
                        number of radial basis for magnetic part (default: 8)
  --use_magmom_one_body USE_MAGMOM_ONE_BODY
                        If true, use one body mangetic moment contribution in
                        the model (default: False)
  --train_one_body_contribution TRAIN_ONE_BODY_CONTRIBUTION
                        If true, include the magmom one-body coefficients in
                        the optimizer (only relevant when
                        --use_magmom_one_body is set). (default: True)
  --data_aug_magmom DATA_AUG_MAGMOM
                        Whether to use data augmentation on magnetic moment
                        training. (default: False)
  --data_aug_magmom_mode {soc,non-soc}
                        Which magnetic symmetries to augment. 'non-soc' draws
                        from the full O(3)_spin (random rotation AND global
                        sign flip), valid when the energy is invariant under
                        rotating the moments independently of the lattice.
                        'soc' applies ONLY the sign flip m -> -m: with spin-
                        orbit coupling a free spin rotation is not a symmetry,
                        so augmenting with it would teach an invariance the
                        model must not have, while time reversal still holds
                        at zero field. (default: non-soc)

Args that start with '--' can also be set in a config file (specified via
--config). The config file uses YAML syntax and must represent a YAML
'mapping' (for details, see http://learn.getgrav.org/advanced/yaml). In
general, command-line values override config file values which override
defaults.


