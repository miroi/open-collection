  --launcher {slurm,torchrun,mpi,none}
                        How the job was launched (default: slurm)
  --log_level LOG_LEVEL
                        log level (default: INFO)
  --plot PLOT           Plot results of training (default: True)
  --plot_frequency PLOT_FREQUENCY
                        Set plotting frequency: '0' for only at the end or an
                        integer N to plot every N epochs. (default: 0)
  --plot_interaction_e PLOT_INTERACTION_E
                        Whether to plot energy without E0s (default: False)
  --error_table {PerAtomRMSE,TotalRMSE,PerAtomRMSEstressvirials,PerAtomMAEstressvirials,PerAtomMAE,TotalMAE,DipoleRMSE,DipoleMAE,DipolePolarRMSE,EnergyDipoleRMSE}
                        Type of error table produced at the end of the
                        training (default: PerAtomRMSE)
  --model {BOTNet,MACE,ScaleShiftMACE,PolarMACE,MACELES,ScaleShiftBOTNet,AtomicDipolesMACE,AtomicDielectricMACE,EnergyDipolesMACE,MagneticScaleShiftMACE}
                        model type (default: MACE)
  --r_max R_MAX         distance cutoff (in Ang) (default: 5.0)
  --radial_type {bessel,gaussian,chebyshev}
                        type of radial basis functions (default: bessel)
  --num_radial_basis NUM_RADIAL_BASIS
                        number of radial basis functions (default: 8)
  --num_cutoff_basis NUM_CUTOFF_BASIS
                        number of basis functions for smooth cutoff (default:
                        5)
  --pair_repulsion      use pair repulsion term with ZBL potential (default:
                        False)
  --distance_transform {None,Agnesi,Soft}
                        use distance transform for radial basis functions
                        (default: None)
  --apply_cutoff APPLY_CUTOFF
                        apply cutoff to the radial basis functions before MLP
                        (default: True)
  --use_last_readout_only USE_LAST_READOUT_ONLY
                        use only the last readout for the final output
                        (default: False)
  --use_embedding_readout USE_EMBEDDING_READOUT
                        use embedding readout for the final output (default:
                        False)
  --interaction {RealAgnosticResidualInteractionBlock,RealAgnosticAttResidualInteractionBlock,RealAgnosticInteractionBlock,RealAgnosticDensityInteractionBlock,RealAgnosticDensityResidualInteractionBlock,RealAgnosticResidualNonLinearInteractionBlock,MagneticRealAgnosticResidueSpinOrbitCoupledDensityInteractionBlock,MagneticRealAgnosticSpinOrbitCoupledDensityInteractionBlock}
                        name of interaction block (default:
                        RealAgnosticResidualInteractionBlock)
  --interaction_first {RealAgnosticResidualInteractionBlock,RealAgnosticInteractionBlock,RealAgnosticDensityInteractionBlock,RealAgnosticDensityResidualInteractionBlock,RealAgnosticResidualNonLinearInteractionBlock,MagneticRealAgnosticResidueSpinOrbitCoupledDensityInteractionBlock,MagneticRealAgnosticSpinOrbitCoupledDensityInteractionBlock}
                        name of interaction block (default:
                        RealAgnosticResidualInteractionBlock)
  --max_ell MAX_ELL     highest \ell of spherical harmonics (default: 3)
  --correlation CORRELATION
                        correlation order at each layer (default: 3)
  --use_reduced_cg USE_REDUCED_CG
                        use reduced generalized Clebsch-Gordan coefficients
                        (default: False)
  --use_so3 USE_SO3     use SO(3) irreps instead of O(3) irreps (default:
                        False)
  --use_agnostic_product USE_AGNOSTIC_PRODUCT
                        use element agnostic product (default: False)
  --num_interactions NUM_INTERACTIONS
                        number of interactions (default: 2)
  --MLP_irreps MLP_IRREPS
                        hidden irreps of the MLP in last readout (default:
