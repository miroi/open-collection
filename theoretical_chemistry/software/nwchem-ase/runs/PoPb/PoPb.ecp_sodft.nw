start pbpo_sodft
echo

# --- Memory and charge ---
memory 4000 mb
charge 0

# --- Geometry (C∞v, no symmetry for SODFT) ---
geometry noautosym noautoz units angstrom
  Pb   0.000000   0.000000   0.000000
  Po   0.000000   0.000000   2.730000
end

# =============================================================================
# BASIS SETS AND EFFECTIVE CORE POTENTIALS
# =============================================================================
# CRITICAL: NWChem has NO spin-orbit potentials in its library.
# You MUST paste the ECP and SO data from the Stuttgart/Köln library.
# The placeholder sections below show the expected format.
# =============================================================================

basis "ao basis" cartesian print
  # -------------------------------------------------------------------------
  # Pb Orbital Basis (ECP60MDF)
  # Paste the orbital basis functions for Pb here.
  # -------------------------------------------------------------------------
  Pb    S
        #PASTE_Pb_ORBITAL_S_DATA_HERE
  Pb    P
        #PASTE_Pb_ORBITAL_P_DATA_HERE
  Pb    D
        #PASTE_Pb_ORBITAL_D_DATA_HERE
  # -------------------------------------------------------------------------
  # Po Orbital Basis (ECP60MDF)
  # Paste the orbital basis functions for Po here.
  # -------------------------------------------------------------------------
  Po    S
        #PASTE_Po_ORBITAL_S_DATA_HERE
  Po    P
        #PASTE_Po_ORBITAL_P_DATA_HERE
  Po    D
        #PASTE_Po_ORBITAL_D_DATA_HERE
end

# --- Scalar-relativistic ECPs (ECP directive) ---
# Paste the scalar ECP parameters for Pb and Po from the Stuttgart library.
ECP
  # -------------------------------------------------------------------------
  # Pb ECP (e.g., ECP60MDF, 60 core electrons)
  # -------------------------------------------------------------------------
  Pb    nelec 60
        #PASTE_Pb_ECP_UL_AND_COEFFICIENTS
  # -------------------------------------------------------------------------
  # Po ECP (e.g., ECP60MDF, 60 core electrons)
  # NOTE: Ensure the core size matches the SO potential exactly.
  # -------------------------------------------------------------------------
  Po    nelec 60
        #PASTE_Po_ECP_UL_AND_COEFFICIENTS
end

# --- Spin-Orbit potentials (SO directive) ---
# Paste the SO parameters from the Stuttgart library.
# These are already scaled correctly for NWChem; use them as-is[citation:3].
SO
  # -------------------------------------------------------------------------
  # Pb SO potential (matching ECP60MDF core)
  # -------------------------------------------------------------------------
  Pb
        #PASTE_Pb_SO_COEFFICIENTS
  # -------------------------------------------------------------------------
  # Po SO potential (matching ECP60MDF core)
  # -------------------------------------------------------------------------
  Po
        #PASTE_Po_SO_COEFFICIENTS
end

# =============================================================================
# DFT / SODFT SETTINGS
# =============================================================================

dft
  # Exchange-correlation functional (PBE is a common starting point)
  xc pbe
  
  # Convergence settings for SODFT
  convergence
    energy 1e-7
    density 1e-6
    gradient 5e-6
  end
  
  # Maximum SCF iterations
  maxiter 200
  
  # Multiplicity is not used for two-component SODFT (alpha/beta symmetries are broken)[citation:2]
  # mult 1
end

# =============================================================================
# TASK
# =============================================================================
# Use "optimize" for geometry, "energy" for single-point.
task sodft optimize
