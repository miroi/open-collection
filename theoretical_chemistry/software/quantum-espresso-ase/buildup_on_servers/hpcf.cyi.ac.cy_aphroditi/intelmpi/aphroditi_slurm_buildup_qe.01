#!/bin/bash

#SBATCH -A p326

#SBATCH --job-name=QEbuild
#SBATCH --partition=milan
#SBATCH --nodes=1
#SBATCH --ntasks-per-node=8
#SBATCH --time=8:00:00

## stdout/stderr output file
##SBATCH --output=job.%j.out # Stdout (%j=jobId)
##SBATCH --error=job.%j.err # Stderr (%j=jobId)
#SBATCH -o log_slurm_job.%j.%N.std_out
#SBATCH -e log_slurm_job.%j.%N.std_err

## email
#SBATCH --mail-user=milias@theor.jinr.ru
#SBATCH --mail-type=ALL

echo -e "\n\nRunning on host `hostname`"
echo -e "Date & Time is `date` \n"

echo -e "\n\n The total memory at the node (in GB)"
free -t -g

echo -e "\n\nJob user is SLURM_JOB_USER= $SLURM_JOB_USER"
echo -e "User job SLURM_JOB_NAME=$SLURM_JOB_NAME has assigned ID SLURM_JOBID=$SLURM_JOBID"
echo -e "This job was submitted from the computer SLURM_SUBMIT_HOST=$SLURM_SUBMIT_HOST"
echo -e "and from the home directory SLURM_SUBMIT_DIR:"
echo -e "$SLURM_SUBMIT_DIR"

echo -e "Job is running on the cluster compute node: SLURM_CLUSTER_NAME=$SLURM_CLUSTER_NAME"
echo -e "and is employing SLURM_JOB_NUM_NODES=$SLURM_JOB_NUM_NODES node/nodes:"
echo -e "SLURM_JOB_NODELIST = $SLURM_JOB_NODELIST"
echo -e "Job partition is SLURM_JOB_PARTITION=$SLURM_JOB_PARTITION \n"
echo -e "Number of allocated CPUs on each single node, SLURM_CPUS_ON_NODE=$SLURM_CPUS_ON_NODE ."
echo -e "Number of all reserved threads over ALL nodes, SLURM_NTASKS=$SLURM_NTASKS ."
echo -e "Job has reserved memory per node, SLURM_MEM_PER_NODE=$SLURM_MEM_PER_NODE MB of memory"

# CPU model, total numer of CPUs, number of allocated CPUs
echo -e "The node's CPU \c"; cat /proc/cpuinfo | grep 'model name' | uniq
NPROCS=`cat /proc/cpuinfo | grep processor | wc -l`
echo "BTW, this node has total $NPROCS CPUs available for an EXCLUSIVE job."
echo "Based on reserved memory, this node got $SLURM_CPUS_ON_NODE CPUs allocated for SLURM calculations."
echo "This job wants SLURM_NTASKS=$SLURM_NTASKS threads . "

#RATIO=$(( $SLURM_CPUS_ON_NODE / $SLURM_NTASKS ))
#echo -e "Ratio SLURM_CPUS_ON_NODE/SLURM_NTASKS=$SLURM_CPUS_ON_NODE/$SLURM_NTASKS=\c";echo $(( $SLURM_CPUS_ON_NODE / $SLURM_NTASKS ))
#echo -e $RATIO
# set OpenMP threads accordingly
#export USE_OPENMP=1
#export OPENBLAS_NUM_THREADS=$RATIO
#echo -e "\nFor openblas internal parallelization, OPENBLAS_NUM_THREADS=$OPENBLAS_NUM_THREADS"

echo -e "\n\n First purge, than loading modules:"
module purge
module load Python 
module load CMake
module load HDF5
module load libxc
module load intel
echo -e "\n...loaded modules :"
module list

echo -e "\n\n python ? ; python -V :\c"; which python; python -V
echo -e "\n cmake ? \c"; which cmake; cmake --version
echo -e "\n\n         ***  IntelMPI+MKL  ***  "
echo -e "\n ifort ?: \c"; which ifort; ifort -V
echo -e "\n mpiifort ? : \c";which mpiifort; mpiifort -V
echo -e "\n icc ? :\c"; which icc; icc -V
echo -e "\n icpc ? : \c"; which icpc; icpc -V
echo -e "\n Intel MKL library ? MKLROOT=$MKLROOT"
echo -e "\n mpiexec ?  :\c"; which mpiexec; mpiexec --version

echo -e "\n\n My PATH=$PATH\n"
echo -e "\n My LD_LIBRARY_PATH=$LD_LIBRARY_PATH "

# for running jobs from your homedir, use ...
#cd $SLURM_SUBMIT_DIR

#QE=/lustre/projects/m/milias/work/software/quantum-espresso/git_cloned/q-e_cloned
QE=/nvme/h/ru26mi1/work/software/quantum-espresso/q-e_cloned

#BUILD=build_intelmpi2025.3.1_libxc_mkl_scalapack
BUILD=build_intelmpi_mkl_scalapack_libxc_hdf5

echo -e "\n\n QE=$QE"
echo -e "ls $QE/"
ls $QE/

cd $QE
echo -e "\n I am in QE=\c";pwd

if [ -d "$BUILD" ]; then
  echo -e "\n The directory $QE/$BUILD does exist."
  echo -e "Its old content :"; ls -lt $QE/$BUILD/.
  echo -e "Deleting it and re-creating again."
  /bin/rm -rf $BUILD
  mkdir $BUILD
else
  echo -e "\n The directory  $QE/$BUILD does not exist, creating it."
  mkdir $BUILD
fi
cd $BUILD

echo -e "\n Current directory where this SLURM job is running `pwd`"
echo -e " Current directory  QE/BUILD=$QE/$BUILD "
echo " It has the disk space of (df -h) :"
df -h .
echo -e "\n ls -lt $PWD"; ls -lt

#
# see https://gitlab.com/QEF/q-e/-/wikis/Developers/CMake-build-system
#

echo -e "\n\n\n Running cmake :"
#cmake -DQE_ENABLE_MPI=ON -DQE_ENABLE_MPI_MODULE=ON -DCMAKE_C_COMPILER=icc -DCMAKE_CXX_COMPILER=icpc -DCMAKE_Fortran_COMPILER=mpiifort -DCMAKE_Fortran_FLAGS="-g -Winline -diag-dump -diag-enable=all"  .. 

#cmake -DQE_ENABLE_MPI=ON -DQE_ENABLE_MPI_MODULE=ON -DCMAKE_C_COMPILER=icc -DCMAKE_CXX_COMPILER=icpc -DCMAKE_Fortran_COMPILER=mpiifort -DCMAKE_Fortran_FLAGS="-g -Winline -diag-enable=all -qopt-report=4 -qopt-report-phase ipo"  .. 


#LIBXC_DIR=/lustre/projects/m/milias/work/software/libxc/install_build_intel2023.1
LIBXC_DIR=/lustre/projects/m/milias/work/software/libxc/install_build_intel2025.3.1
LIBXC_INC=$LIBXC_DIR/include
#cmake -DQE_ENABLE_MPI=ON -DQE_ENABLE_MPI_MODULE=ON -DCMAKE_C_COMPILER=icx -DCMAKE_CXX_COMPILER=icpx -DCMAKE_Fortran_COMPILER=mpiifx -DCMAKE_Fortran_FLAGS="-g -traceback" -DQE_ENABLE_SCALAPACK=ON -DQE_ENABLE_LIBXC=ON  -DLIBXC_ROOT=$LIBXC_DIR  -DLIBXC_INCLUDE_DIR=$LIBXC_INC  -DQE_ENABLE_HDF5=OFF  .. 

# see https://gitlab.com/QEF/q-e/-/work_items/844
#cmake -DQE_ENABLE_MPI=ON -DQE_ENABLE_MPI_MODULE=ON -DCMAKE_C_COMPILER=icx -DCMAKE_CXX_COMPILER=icpx -DCMAKE_Fortran_COMPILER=mpiifx -DCMAKE_Fortran_FLAGS="-xHost -g -traceback"  -DCMAKE_C_FLAGS="-xHost"  -DQE_ENABLE_SCALAPACK=ON -DQE_ENABLE_LIBXC=ON  -DLIBXC_ROOT=$LIBXC_DIR  -DLibxc_VERSION="7.0.0"  -DQE_ENABLE_HDF5=OFF  .. 

#cmake -DQE_ENABLE_MPI=ON -DQE_ENABLE_MPI_MODULE=ON -DCMAKE_C_COMPILER=icx -DCMAKE_CXX_COMPILER=icpx -DCMAKE_Fortran_COMPILER=mpiifx -DCMAKE_Fortran_FLAGS="-xHost -g -traceback"  -DCMAKE_C_FLAGS="-xHost"  -DQE_ENABLE_SCALAPACK=ON -DQE_ENABLE_LIBXC=ON  -DLIBXC_ROOT=$LIBXC_DIR  -DLibxc_VERSION="7.0.0"  -DQE_ENABLE_HDF5=OFF -DMPIEXEC_PREFLAGS="-v " -DMPIEXEC_NUMPROC_FLAG="-np 2"   .. 

#cmake -DQE_ENABLE_MPI=ON -DQE_ENABLE_MPI_MODULE=ON -DCMAKE_C_COMPILER=icx -DCMAKE_CXX_COMPILER=icpx -DCMAKE_Fortran_COMPILER=mpiifx -DCMAKE_Fortran_FLAGS="-xHost -g -traceback"  -DCMAKE_C_FLAGS="-xHost"  -DQE_ENABLE_SCALAPACK=ON -DQE_ENABLE_LIBXC=ON  -DLIBXC_ROOT=$LIBXC_DIR  -DLibxc_VERSION="7.0.0"  -DQE_ENABLE_HDF5=ON  -DHDF5_ROOT=/lustre/projects/m/milias/work/software/hdf5/hdf5-2.1.1/install_build_intelmpi2026.1  .. 

#cmake -DQE_ENABLE_MPI=ON -DQE_ENABLE_MPI_MODULE=ON -DCMAKE_C_COMPILER=mpiicx -DCMAKE_CXX_COMPILER=mpiicpx -DCMAKE_Fortran_COMPILER=mpiifx -DCMAKE_Fortran_FLAGS="-xHost -g -traceback"  -DCMAKE_C_FLAGS="-xHost"  -DQE_ENABLE_SCALAPACK=ON -DQE_ENABLE_LIBXC=ON  -DLIBXC_ROOT=$LIBXC_DIR  -DLibxc_VERSION="7.0.0"  -DQE_ENABLE_HDF5=ON  -DHDF5_ROOT=/lustre/projects/m/milias/work/software/hdf5/hdf5-2.1.1/install_build_intelmpi2026.1  -DHDF5_PREFER_PARALLEL=ON  -DHDF5_IS_PARALLEL=ON .. 

#cmake -DQE_ENABLE_MPI=ON -DQE_ENABLE_MPI_MODULE=ON -DCMAKE_C_COMPILER=mpiicc -DCMAKE_CXX_COMPILER=mpiicpc -DCMAKE_Fortran_COMPILER=mpiifort -DCMAKE_Fortran_FLAGS="-xHost -g -traceback"  -DCMAKE_C_FLAGS="-xHost"  -DQE_ENABLE_SCALAPACK=ON -DQE_ENABLE_LIBXC=OFF  -DQE_ENABLE_HDF5=OFF  .. 

cmake -DQE_ENABLE_MPI=ON -DQE_ENABLE_MPI_MODULE=ON -DCMAKE_C_COMPILER=mpiicc -DCMAKE_CXX_COMPILER=mpiicpc -DCMAKE_Fortran_COMPILER=mpiifort -DCMAKE_Fortran_FLAGS="-O3"  -DCMAKE_C_FLAGS="-O3"  -DQE_ENABLE_SCALAPACK=ON  -DQE_ENABLE_LIBXC=ON  -DQE_ENABLE_HDF5=ON  .. 

echo -e "\n\n Running make -j $SLURM_CPUS_ON_NODE :"
make -j $SLURM_CPUS_ON_NODE

echo -e "\n\n content of $QE/$BUILD/bin  :"
ls -lt $QE/$BUILD/bin

echo -e "\n\n ldd $QE/$BUILD/bin/pw.x :"
ldd $QE/$BUILD/bin/pw.x

#MPIEXEC_PREFLAGS="-v"
#MPIEXEC_MPIEXEC_NUMPROC_FLAG="-np 2"
echo -e "\n\n MPI setting to be used in CTest : " 
echo -e " MPIEXEC_EXECUTABLE=$MPIEXEC_EXECUTABLE"
echo -e " MPIEXEC_NUMPROC_FLAG=$MPIEXEC_NUMPROC_FLAG"
echo -e " MPIEXEC_PREFLAGS=$MPIEXEC_PREFLAGS"
echo -e "  Tests run as : ${MPIEXEC_EXECUTABLE} ${MPIEXEC_NUMPROC_FLAG} <NUM_PROCS> ${MPIEXEC_PREFLAGS_PRINT} <EXECUTABLE>"

echo -e "\n\n running ctest -VV:"
ctest -VV -j2

echo -e "\n\n End of the script. Date & Time is `date` \n"

exit
